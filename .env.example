# Configuração da API OpenRouter
# Substitua YOUR_API_KEY_HERE pela sua chave da API OpenRouter
OPENROUTER_API_KEY=YOUR_API_KEY_HERE

# Configuração do Banco de Dados Neon (PostgreSQL)
# Substitua pela sua URL de conexão do Neon
NETLIFY_DATABASE_URL=YOUR_DATABASE_URL_HERE

# Como obter sua chave da API:
# 1. Acesse https://openrouter.ai/
# 2. Crie uma conta ou faça login
# 3. Vá para "Keys" no menu
# 4. Gere uma nova chave da API
# 5. Copie a chave e cole aqui

# Como configurar o banco Neon:
# 1. Acesse https://neon.tech/
# 2. Crie uma conta e um novo projeto
# 3. Copie a connection string do seu banco
# 4. Cole na variável NETLIFY_DATABASE_URL acima

# IMPORTANTE: Nunca compartilhe suas chaves publicamente!
# Este arquivo é apenas um exemplo. No Netlify, configure as variáveis
# de ambiente diretamente no painel de controle do site.
